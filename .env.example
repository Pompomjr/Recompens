# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma / Postgres (Supabase)
# DATABASE_URL = connection pooler (port 6543, ?pgbouncer=true) — utilisé par l'app
# DIRECT_URL   = connexion directe (port 5432) — utilisé par les migrations
DATABASE_URL=
DIRECT_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fidélité
# Délai minimum, en minutes, entre deux visites validées sur une même carte.
# Empêche de cumuler plusieurs achats d'affilée sur un seul QR partagé.
# 0 = désactivé. Défaut si absent: 30.
LOYALTY_MIN_MINUTES_BETWEEN_VISITS=30
